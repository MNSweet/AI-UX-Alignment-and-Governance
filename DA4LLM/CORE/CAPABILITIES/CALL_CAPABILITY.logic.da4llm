#@da4llm:0.1.0-candidate;@layer:core;@kind:logic;@module:call_capability;
CALL_CAPABILITY_GENERIC{
PRECONDITION: CAPABILITY_REQUESTED
ACTION:
	REQUIRE "CAPABILITY_NAME_PRESENT";
	REQUIRE "INPUT_CONTRACT_RESOLVED";
	IF BRIDGE_MISSING -> SET "CAPABILITY_STATUS=CAPABILITY_UNAVAILABLE";
	IF BRIDGE_MISSING -> EMIT_DIAGNOSTIC "CAPABILITY_UNAVAILABLE";
	IF BRIDGE_PRESENT -> CALL_PROCEDURE "BRIDGE_RESOLVE_CAPABILITY";
	IF CAPABILITY_MAPPING_MISSING -> SET "CAPABILITY_STATUS=CAPABILITY_UNAVAILABLE";
	IF CAPABILITY_MAPPING_MISSING -> EMIT_DIAGNOSTIC "CAPABILITY_UNAVAILABLE";
	IF CAPABILITY_AVAILABLE & GOVERNANCE_PRESENT -> CALL_PROCEDURE "DISPATCH_HOOK_PRE_CAPABILITY";
	IF HOOK_STATUS_DENIED|HOOK_STATUS_LOCKED -> DENY "CAPABILITY_DENIED_BY_GOVERNANCE";
	IF HOOK_STATUS_DENIED|HOOK_STATUS_LOCKED -> HALT;
	IF HOOK_STATUS_APPROVAL_REQUIRED -> ERROR "CAPABILITY_APPROVAL_REQUIRED";
	IF HOOK_STATUS_APPROVAL_REQUIRED -> HALT;
	IF CAPABILITY_AVAILABLE & (!GOVERNANCE_PRESENT|HOOK_STATUS_NO_OP|HOOK_STATUS_ALLOWED|HOOK_STATUS_UNLOCKED|HOOK_STATUS_EXTENSION_ACTIVATED) -> CALL_PROCEDURE "BRIDGE_INVOKE_CAPABILITY";
	IF CAPABILITY_CALL_COMPLETE & GOVERNANCE_PRESENT -> CALL_PROCEDURE "DISPATCH_HOOK_POST_CAPABILITY";
	IF CAPABILITY_STATUS_UNAVAILABLE & CALLER_ON_UNAVAILABLE_CONTINUE -> RETURN "CAPABILITY_RESULT";
	IF CAPABILITY_STATUS_UNAVAILABLE & CALLER_ON_UNAVAILABLE_HALT -> ERROR "CAPABILITY_UNAVAILABLE";
	IF CAPABILITY_STATUS_UNAVAILABLE & CALLER_ON_UNAVAILABLE_HALT -> HALT;
	IF CAPABILITY_CALL_COMPLETE -> RETURN "CAPABILITY_RESULT";
STATE:{IN=CAPABILITY_NAME|CAPABILITY_INPUTS|CALLER_ON_UNAVAILABLE;OUT=CAPABILITY_RESULT|CAPABILITY_STATUS|DIAGNOSTICS;BRIDGE=OPTIONAL;GOVERNANCE=OPTIONAL}
}
