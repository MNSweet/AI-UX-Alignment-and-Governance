#@da4llm:0.1.0-candidate;@layer:core;@kind:logic;@module:core_bootstrap;
CORE_BOOTSTRAP{
PRECONDITION: DA4LLM_CONTEXT_AVAILABLE
ACTION:
	REQUIRE "LOGIC_LEXER_PRESENT";
	REQUIRE "LOGIC_PARSER_PRESENT";
	REQUIRE "LOGIC_PROCEDURES_PRESENT";
	REQUIRE "SEMANTIC_OPCODES_PRESENT";
	REQUIRE "SEMANTIC_PRIMITIVES_PRESENT";
	REQUIRE "CORE_VALIDATOR_PRESENT";
	IF REQUIRED_CORE_MODULE_MISSING -> ERROR "CORE_MODULE_MISSING";
	IF REQUIRED_CORE_MODULE_MISSING -> HALT;
	IF REQUIRED_CORE_MODULE_PRESENT -> CALL_PROCEDURE "VALIDATE_CORE";
	IF CORE_VALID -> SET "CORE_READY=TRUE";
	IF CORE_VALID -> CONTINUE;
STATE:{IN=DA4LLM_CONTEXT|EXECUTION_MODE;OUT=CORE_READY|CORE_DIAGNOSTICS;LOAD_ORDER=LEXER_LOGIC>LEXER_SEMANTIC>PARSER_LOGIC>PARSER_SEMANTIC>OPCODES_LOGIC>OPCODES_SEMANTIC>PRIMITIVES_LOGIC>PRIMITIVES_SEMANTIC>PROCEDURES_LOGIC>PROCEDURES_SEMANTIC>CAPABILITY_LOGIC>CAPABILITY_SEMANTIC>HOOK_LOGIC>HOOK_SEMANTIC>VALIDATOR_LOGIC>VALIDATOR_SEMANTIC;OPTIONAL=BRIDGE|GOVERNANCE}
}
