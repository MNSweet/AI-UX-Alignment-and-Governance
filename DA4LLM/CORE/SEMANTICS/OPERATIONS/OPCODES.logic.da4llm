#@da4llm:0.1.0-candidate;@layer:core;@kind:logic;@module:opcodes;
RESOLVE_OPCODE{
PRECONDITION: OPCODE_NAME_PRESENT
ACTION:
	IF OPCODE_NAME_CANONICAL -> SET "OPCODE_RESOLVED=TRUE";
	IF OPCODE_NAME_UNKNOWN -> ERROR "OPCODE_UNKNOWN";
	IF OPCODE_NAME_UNKNOWN -> HALT;
	IF OPCODE_RESOLVED -> RETURN "OPCODE_CONTRACT";
STATE:{IN=OPCODE_NAME;OUT=OPCODE_CONTRACT|DIAGNOSTICS;REGISTRY=EMIT_RESPONSE|EMIT_DIAGNOSTIC|EMIT_CONTEXT|EMIT_TRACE|HALT|CONTINUE|RETRY|REQUIRE|ASSERT|WARN|ERROR|DENY|SET|CLEAR|PUSH_STATE|POP_STATE|CALL_PROCEDURE|CALL_CAPABILITY|APPLY_OPCODE|RETURN|LOCK_EXTENSION|UNLOCK_EXTENSION|ACTIVATE_EXTENSION}
}

APPLY_OPCODE_CONTRACT{
PRECONDITION: OPCODE_CONTRACT_PRESENT
ACTION:
	REQUIRE "INPUTS_RESOLVED";
	IF INPUTS_UNRESOLVED -> ERROR "OPCODE_INPUT_UNRESOLVED";
	IF INPUTS_UNRESOLVED -> HALT;
	IF INTRINSIC_RESTRICTION_VIOLATED -> ERROR "OPCODE_RESTRICTION_VIOLATED";
	IF INTRINSIC_RESTRICTION_VIOLATED -> HALT;
	APPLY_OPCODE "OPCODE_NAME";
	RETURN "OPCODE_RESULT";
STATE:{IN=OPCODE_CONTRACT|INPUTS|STATE;OUT=OPCODE_RESULT|STATE|TRACE|DIAGNOSTICS;ORDER=RESOLVE>VALIDATE>APPLY>RETURN}
}
