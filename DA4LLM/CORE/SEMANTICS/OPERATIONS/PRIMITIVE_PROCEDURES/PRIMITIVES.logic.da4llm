#@da4llm:0.1.0-candidate;@layer:core;@kind:logic;@module:primitives;
OVERLAP_EXISTS_PRIMITIVE{
PRECONDITION: START
ACTION:
	SET "RESULT=FALSE";
	IF A_MISSING|B_MISSING|A_EMPTY|B_EMPTY -> RETURN "RESULT";
	IF SHARED_MEMBER_EXISTS -> SET "RESULT=TRUE";
	RETURN "RESULT";
STATE:{IN=A|B;OUT=RESULT;TYPE=BOOLEAN;TAG=PRIMITIVE}
}

ROUND_HALF_UP_PRIMITIVE{
PRECONDITION: VALUE_PRESENT & DP_PRESENT
ACTION:
	IF VALUE_NOT_NUMBER|DP_NOT_INTEGER -> ERROR "PRIMITIVE_TYPE_INVALID";
	IF VALUE_NOT_NUMBER|DP_NOT_INTEGER -> HALT;
	SET "RESULT=ROUND_HALF_UP(VALUE,DP)";
	RETURN "RESULT";
STATE:{IN=VALUE|DP;OUT=RESULT;TYPE=NUMBER;TAG=PRIMITIVE}
}

REPEAT_PRIMITIVE{
PRECONDITION: GLYPH_PRESENT & COUNT_PRESENT
ACTION:
	IF COUNT<=0 -> SET "RESULT=EMPTY_STRING";
	IF COUNT>0 -> SET "RESULT=REPEAT(GLYPH,COUNT)";
	RETURN "RESULT";
STATE:{IN=GLYPH|COUNT;OUT=RESULT;TYPE=STRING;TAG=PRIMITIVE}
}

TO_INTEGER_PRIMITIVE{
PRECONDITION: VALUE_PRESENT
ACTION:
	IF INTEGER_CONVERSION_INVALID -> ERROR "PRIMITIVE_CONVERSION_INVALID";
	IF INTEGER_CONVERSION_INVALID -> HALT;
	SET "RESULT=INTEGER(VALUE)";
	RETURN "RESULT";
STATE:{IN=VALUE;OUT=RESULT;TYPE=INTEGER;TAG=PRIMITIVE}
}

TO_FLOAT_PRIMITIVE{
PRECONDITION: VALUE_PRESENT
ACTION:
	IF FLOAT_CONVERSION_INVALID -> ERROR "PRIMITIVE_CONVERSION_INVALID";
	IF FLOAT_CONVERSION_INVALID -> HALT;
	SET "RESULT=FLOAT(VALUE)";
	RETURN "RESULT";
STATE:{IN=VALUE;OUT=RESULT;TYPE=FLOAT;TAG=PRIMITIVE}
}

STRING_LENGTH_PRIMITIVE{
PRECONDITION: START
ACTION:
	IF S_NULL|S_MISSING -> SET "RESULT=0";
	IF S_PRESENT -> SET "RESULT=STRING_LENGTH(S)";
	RETURN "RESULT";
STATE:{IN=S;OUT=RESULT;TYPE=INTEGER;TAG=PRIMITIVE}
}

CONCAT_PRIMITIVE{
PRECONDITION: START
ACTION:
	IF A_MISSING -> SET "A=EMPTY_STRING";
	IF B_MISSING -> SET "B=EMPTY_STRING";
	SET "RESULT=CONCAT(A,B)";
	RETURN "RESULT";
STATE:{IN=A|B;OUT=RESULT;TYPE=STRING;TAG=PRIMITIVE}
}

SUBSTRING_PRIMITIVE{
PRECONDITION: START
ACTION:
	IF S_MISSING -> SET "RESULT=EMPTY_STRING";
	IF S_MISSING -> RETURN "RESULT";
	IF !START_PRESENT|!LENGTH_PRESENT -> ERROR "PRIMITIVE_INPUT_MISSING";
	IF !START_PRESENT|!LENGTH_PRESENT -> HALT;
	SET "RESULT=SUBSTRING(S,START,LENGTH)";
	RETURN "RESULT";
STATE:{IN=S|START|LENGTH;OUT=RESULT;TYPE=STRING;TAG=PRIMITIVE}
}

SPLIT_PRIMITIVE{
PRECONDITION: START
ACTION:
	IF S_MISSING -> SET "RESULT=EMPTY_LIST";
	IF S_PRESENT -> SET "RESULT=SPLIT(S,DELIMITER)";
	RETURN "RESULT";
STATE:{IN=S|DELIMITER;OUT=RESULT;TYPE=LIST;TAG=PRIMITIVE}
}

JOIN_PRIMITIVE{
PRECONDITION: START
ACTION:
	IF L_EMPTY|L_MISSING -> SET "RESULT=EMPTY_STRING";
	IF L_PRESENT -> SET "RESULT=JOIN(L,DELIMITER)";
	RETURN "RESULT";
STATE:{IN=L|DELIMITER;OUT=RESULT;TYPE=STRING;TAG=PRIMITIVE}
}
