#@da4llm:0.1.0-candidate;@layer:core;@kind:logic;@module:extension_hooks;
DISPATCH_HOOK{
PRECONDITION: HOOK_REACHED
ACTION:
	IF GOVERNANCE_MISSING -> SET "HOOK_STATUS=NO_OP";
	IF GOVERNANCE_MISSING -> RETURN "HOOK_STATUS";
	IF HOOK_NAME_UNKNOWN -> ERROR "HOOK_UNKNOWN";
	IF HOOK_NAME_UNKNOWN -> HALT;
	IF GOVERNANCE_PRESENT & HOOK_NAME_DECLARED -> CALL_PROCEDURE "GOVERNANCE_HANDLE_HOOK";
	IF GOVERNANCE_RESULT_INVALID -> ERROR "GOVERNANCE_EXTENSION_INVALID";
	IF GOVERNANCE_RESULT_INVALID -> HALT;
	IF GOVERNANCE_RESULT_ALLOW -> SET "HOOK_STATUS=ALLOWED";
	IF GOVERNANCE_RESULT_DENY -> SET "HOOK_STATUS=DENIED";
	IF GOVERNANCE_RESULT_APPROVAL_REQUIRED -> SET "HOOK_STATUS=APPROVAL_REQUIRED";
	IF GOVERNANCE_RESULT_LOCK -> LOCK_EXTENSION "EXTENSION_ID";
	IF GOVERNANCE_RESULT_LOCK -> SET "HOOK_STATUS=LOCKED";
	IF GOVERNANCE_RESULT_UNLOCK -> UNLOCK_EXTENSION "EXTENSION_ID";
	IF GOVERNANCE_RESULT_UNLOCK -> SET "HOOK_STATUS=UNLOCKED";
	IF GOVERNANCE_RESULT_ACTIVATE -> ACTIVATE_EXTENSION "EXTENSION_ID";
	IF GOVERNANCE_RESULT_ACTIVATE -> SET "HOOK_STATUS=EXTENSION_ACTIVATED";
	RETURN "HOOK_STATUS";
STATE:{IN=HOOK_NAME|HOOK_CONTEXT|GOVERNANCE_STATE;OUT=HOOK_STATUS|EXTENSION_STATE|DIAGNOSTICS;HOOKS=PRE_EXECUTION|PRE_CAPABILITY|POST_CAPABILITY|PRE_OUTPUT|POST_OUTPUT}
}

DISPATCH_HOOK_PRE_EXECUTION{
PRECONDITION: EXECUTION_VALIDATED
ACTION:
	SET "HOOK_NAME=PRE_EXECUTION";
	CALL_PROCEDURE "DISPATCH_HOOK";
	RETURN "HOOK_STATUS";
STATE:{IN=REQUEST|CORE_STATE;OUT=HOOK_STATUS|EXTENSION_STATE;TAG=HOOK}
}

DISPATCH_HOOK_PRE_CAPABILITY{
PRECONDITION: CAPABILITY_AVAILABLE
ACTION:
	SET "HOOK_NAME=PRE_CAPABILITY";
	CALL_PROCEDURE "DISPATCH_HOOK";
	RETURN "HOOK_STATUS";
STATE:{IN=CAPABILITY_NAME|CAPABILITY_INPUTS|CORE_STATE;OUT=HOOK_STATUS|EXTENSION_STATE;TAG=HOOK}
}

DISPATCH_HOOK_POST_CAPABILITY{
PRECONDITION: CAPABILITY_CALL_COMPLETE
ACTION:
	SET "HOOK_NAME=POST_CAPABILITY";
	CALL_PROCEDURE "DISPATCH_HOOK";
	RETURN "HOOK_STATUS";
STATE:{IN=CAPABILITY_NAME|CAPABILITY_RESULT|CORE_STATE;OUT=HOOK_STATUS|EXTENSION_STATE;TAG=HOOK}
}

DISPATCH_HOOK_PRE_OUTPUT{
PRECONDITION: OUTPUT_PENDING
ACTION:
	SET "HOOK_NAME=PRE_OUTPUT";
	CALL_PROCEDURE "DISPATCH_HOOK";
	RETURN "HOOK_STATUS";
STATE:{IN=OUTPUT|CORE_STATE;OUT=HOOK_STATUS|EXTENSION_STATE;TAG=HOOK}
}

DISPATCH_HOOK_POST_OUTPUT{
PRECONDITION: OUTPUT_EMITTED
ACTION:
	SET "HOOK_NAME=POST_OUTPUT";
	CALL_PROCEDURE "DISPATCH_HOOK";
	RETURN "HOOK_STATUS";
STATE:{IN=OUTPUT|CORE_STATE;OUT=HOOK_STATUS|EXTENSION_STATE;TAG=HOOK}
}
