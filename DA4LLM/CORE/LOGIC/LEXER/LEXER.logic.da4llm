#@da4llm:0.1.0-candidate;@layer:core;@kind:logic;@module:lexer;
LEXER_DEFINE_TOKENS{
PRECONDITION: START
ACTION:
	SET "DIRECTIVE=#@KEY:VALUE(;@KEY:VALUE)*;";
	SET "NAME=[A-Z][A-Z0-9_]{0,47}";
	SET "STRING=DOUBLE_QUOTED_SINGLE_LINE_UTF_8";
	SET "INTEGER=OPTIONAL_MINUS_DIGITS";
	SET "FLOAT=OPTIONAL_MINUS_DIGITS_DOT_DIGITS";
	SET "BOOLEAN=TRUE|FALSE";
	SET "NULL=NULL";
	SET "OPERATOR=->|<=|>=|!=|=|!|&|>|<";
	SET "DELIMITER=LBRACE|RBRACE|LPAREN|RPAREN|COLON|SEMICOLON|COMMA|PIPE|NEWLINE";
	RETURN "TOKEN_DEFINITIONS";
STATE:{IN=NONE;OUT=TOKEN_DEFINITIONS;TAG=LEXER_SPEC}
}

LEXER_SCAN{
PRECONDITION: SOURCE_PRESENT
ACTION:
	CALL_PROCEDURE "LEXER_DEFINE_TOKENS";
	SET "CURSOR=SOURCE_START";
	SET "LINE=1";
	SET "COLUMN=1";
	IF SOURCE_ENCODING_INVALID -> ERROR "SOURCE_ENCODING_INVALID";
	IF SOURCE_ENCODING_INVALID -> HALT;
	IF DIRECTIVE_FIRST_LINE_MISSING -> ERROR "DIRECTIVE_MISSING";
	IF DIRECTIVE_FIRST_LINE_MISSING -> HALT;
	CALL_PROCEDURE "LEXER_SCAN_NEXT";
	RETURN "TOKEN_STREAM";
STATE:{IN=SOURCE;OUT=TOKEN_STREAM|LEXER_DIAGNOSTICS;ORDER=LEFT_TO_RIGHT;BOUNDARY=NEWLINE;ENCODING=UTF_8}
}

LEXER_SCAN_NEXT{
PRECONDITION: CURSOR_PRESENT & !SOURCE_END
ACTION:
	IF !SPACE & !TAB & !CARRIAGE_RETURN -> CALL_PROCEDURE "LEXER_CLASSIFY";
	IF TOKEN_RECOGNIZED -> PUSH_STATE "TOKEN";
	IF SPACE|TAB|CARRIAGE_RETURN -> SET "CURRENT_LEXEME_COMPLETE=TRUE";
	IF SPACE|TAB|CARRIAGE_RETURN -> CONTINUE;
	IF NEWLINE -> PUSH_STATE "LINE_BOUNDARY";
	IF UNKNOWN_CHARACTER -> ERROR "LEXICAL_TOKEN_UNKNOWN";
	IF UNKNOWN_CHARACTER -> HALT;
	IF CURRENT_LEXEME_COMPLETE -> SET "CURSOR=NEXT_LEXEME";
	IF NEWLINE -> SET "LINE=LINE+1";
	IF NEWLINE -> SET "COLUMN=1";
	IF !NEWLINE -> SET "COLUMN=NEXT_COLUMN";
	IF !SOURCE_END -> RETRY;
	IF SOURCE_END -> RETURN "TOKEN_STREAM";
STATE:{IN=SOURCE|CURSOR|TOKEN_DEFINITIONS|LINE|COLUMN;OUT=TOKEN_STREAM|CURSOR|LINE|COLUMN|LEXER_DIAGNOSTICS;RETRY_BOUND=SOURCE_LENGTH}
}

LEXER_CLASSIFY{
PRECONDITION: CURRENT_LEXEME_PRESENT
ACTION:
	IF DIRECTIVE_PATTERN -> SET "TOKEN_TYPE=DIRECTIVE";
	IF NAME_PATTERN -> SET "TOKEN_TYPE=NAME";
	IF STRING_PATTERN -> SET "TOKEN_TYPE=STRING";
	IF NUMBER_INTEGER_PATTERN -> SET "TOKEN_TYPE=INTEGER";
	IF NUMBER_FLOAT_PATTERN -> SET "TOKEN_TYPE=FLOAT";
	IF BOOLEAN_PATTERN -> SET "TOKEN_TYPE=BOOLEAN";
	IF NULL_PATTERN -> SET "TOKEN_TYPE=NULL";
	IF OPERATOR_PATTERN -> SET "TOKEN_TYPE=OPERATOR";
	IF DELIMITER_PATTERN -> SET "TOKEN_TYPE=DELIMITER";
	IF NO_PATTERN_MATCH -> ERROR "LEXICAL_TOKEN_UNKNOWN";
	IF NO_PATTERN_MATCH -> HALT;
	RETURN "TOKEN_TYPE";
STATE:{IN=CURRENT_LEXEME;OUT=TOKEN_TYPE;TAG=LEXER}
}
