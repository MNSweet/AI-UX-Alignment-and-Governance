#@da4llm:0.1.0-candidate;@layer:core;@kind:logic;@module:validator;
VALIDATE_CORE{
PRECONDITION: CORE_CONTEXT_PRESENT
ACTION:
	SET "CORE_VALID=TRUE";
	CALL_PROCEDURE "VALIDATE_LOAD_ORDER";
	CALL_PROCEDURE "VALIDATE_MODULE_PAIRS";
	CALL_PROCEDURE "VALIDATE_OPCODE_REFERENCES";
	CALL_PROCEDURE "VALIDATE_SEMANTIC_COVERAGE";
	IF VALIDATION_ERROR_PRESENT -> SET "CORE_VALID=FALSE";
	IF CORE_VALID -> RETURN "CORE_VALID";
	IF !CORE_VALID -> ERROR "CORE_VALIDATION_FAILED";
	IF !CORE_VALID -> HALT;
STATE:{IN=CORE_CONTEXT|EXECUTION_MODE;OUT=CORE_VALID|CORE_DIAGNOSTICS;TAG=VALIDATOR}
}

VALIDATE_LOAD_ORDER{
PRECONDITION: CORE_CONTEXT_PRESENT
ACTION:
	IF LEXER_NOT_FIRST -> ERROR "LOAD_ORDER_INVALID";
	IF PARSER_BEFORE_LEXER -> ERROR "LOAD_ORDER_INVALID";
	IF MODULE_EXECUTION_BEFORE_REQUIRED_SEMANTIC -> WARN "SEMANTIC_LOAD_PENDING";
	IF REQUIRED_MODULE_MISSING -> ERROR "CORE_MODULE_MISSING";
	RETURN "LOAD_ORDER_STATUS";
STATE:{IN=ACTIVE_MODULES;OUT=LOAD_ORDER_STATUS|DIAGNOSTICS;AUTHORITY=CORE_BOOTSTRAP}
}

VALIDATE_MODULE_PAIRS{
PRECONDITION: MODULE_LOGIC_PRESENT
ACTION:
	IF MODULE_SEMANTIC_PRESENT & VERSION_MATCH -> SET "SEMANTIC_STATE=SEMANTIC_COMPLETE";
	IF MODULE_SEMANTIC_PRESENT & !VERSION_MATCH -> ERROR "MODULE_VERSION_MISMATCH";
	IF MODULE_SEMANTIC_MISSING -> SET "SEMANTIC_STATE=SEMANTIC_ABSENT";
	IF MODULE_SEMANTIC_PRESENT & SEMANTIC_FIELDS_MISSING -> SET "SEMANTIC_STATE=SEMANTIC_PARTIAL";
	IF EXECUTION_MODE_NORMAL & (SEMANTIC_STATE_ABSENT|SEMANTIC_STATE_PARTIAL) -> CONTINUE;
	IF EXECUTION_MODE_DEBUG & (SEMANTIC_STATE_ABSENT|SEMANTIC_STATE_PARTIAL) -> WARN "SEMANTIC_INCOMPLETE";
	IF EXECUTION_MODE_STRICT & (SEMANTIC_STATE_ABSENT|SEMANTIC_STATE_PARTIAL) -> ERROR "SEMANTIC_REQUIRED";
	IF EXECUTION_MODE_STRICT & (SEMANTIC_STATE_ABSENT|SEMANTIC_STATE_PARTIAL) -> HALT;
	RETURN "SEMANTIC_STATE";
STATE:{IN=LOGIC_MODULE|SEMANTIC_MODULE|EXECUTION_MODE;OUT=SEMANTIC_STATE|DIAGNOSTICS;STATES=SEMANTIC_COMPLETE|SEMANTIC_PARTIAL|SEMANTIC_ABSENT}
}

VALIDATE_OPCODE_REFERENCES{
PRECONDITION: PARSE_TREE_PRESENT
ACTION:
	IF OPCODE_NOT_CANONICAL -> ERROR "OPCODE_UNKNOWN";
	IF PROCEDURE_NOT_DECLARED -> ERROR "PROCEDURE_UNRESOLVED";
	IF INPUT_VARIABLE_UNDECLARED -> ERROR "VARIABLE_UNDECLARED";
	IF OUTPUT_VARIABLE_UNDECLARED -> ERROR "VARIABLE_UNDECLARED";
	IF TYPE_CONFLICT_UNRESOLVED -> ERROR "SEMANTIC_TYPE_UNRESOLVED";
	IF VALIDATION_ERROR_PRESENT -> HALT;
	RETURN "REFERENCE_STATUS";
STATE:{IN=PARSE_TREE|OPCODE_REGISTRY|SEMANTIC_CONTRACT;OUT=REFERENCE_STATUS|DIAGNOSTICS;FAILURE=EXECUTION_CRITICAL}
}

VALIDATE_SEMANTIC_COVERAGE{
PRECONDITION: LOGIC_MODULE_PRESENT
ACTION:
	IF LOGIC_VARIABLE_WITHOUT_DIRECT_SEMANTIC & DERIVED_PREDICATE_BASE_DECLARED -> SET "VARIABLE_SEMANTIC=DERIVED_PREDICATE_SEMANTIC";
	IF LOGIC_VARIABLE_WITHOUT_DIRECT_SEMANTIC & !DERIVED_PREDICATE_BASE_DECLARED -> SET "SEMANTIC_STATE=SEMANTIC_PARTIAL";
	IF LOGIC_OPCODE_WITHOUT_SEMANTIC -> SET "SEMANTIC_STATE=SEMANTIC_PARTIAL";
	IF SEMANTIC_ENTRY_WITH_CONTROL_FLOW -> ERROR "SEMANTIC_CONTAINS_LOGIC";
	IF SEMANTIC_ENTRY_UNUSED & EXECUTION_MODE_DEBUG -> WARN "SEMANTIC_ENTRY_UNUSED";
	IF EXECUTION_CRITICAL_MEANING_MISSING -> ERROR "SEMANTIC_UNRESOLVED";
	IF EXECUTION_CRITICAL_MEANING_MISSING -> HALT;
	RETURN "SEMANTIC_COVERAGE_STATUS";
STATE:{IN=LOGIC_MODULE|SEMANTIC_MODULE|EXECUTION_MODE;OUT=SEMANTIC_COVERAGE_STATUS|DIAGNOSTICS;INFERENCE=NONCRITICAL_ONLY}
}

RESOLVE_SEMANTIC_VALUE{
PRECONDITION: SOURCE_VALUE_PRESENT
ACTION:
	IF SEMANTIC_TYPE_PRESENT -> SET "RESOLUTION_AUTHORITY=SEMANTIC_CONTRACT";
	IF !SEMANTIC_TYPE_PRESENT -> SET "RESOLUTION_AUTHORITY=LEXICAL_DEFAULT";
	IF SEMANTIC_TYPE_PRESENT & VALUE_COMPATIBLE -> SET "RESOLVED_VALUE=SEMANTIC_TYPED_VALUE";
	IF !SEMANTIC_TYPE_PRESENT -> SET "RESOLVED_VALUE=LEXICAL_TYPED_VALUE";
	IF SEMANTIC_TYPE_PRESENT & !VALUE_COMPATIBLE -> ERROR "SEMANTIC_TYPE_UNRESOLVED";
	IF SEMANTIC_TYPE_PRESENT & !VALUE_COMPATIBLE -> HALT;
	IF EXECUTION_CRITICAL & RESOLUTION_REQUIRES_MODEL_GUESS -> ERROR "SEMANTIC_UNRESOLVED";
	IF EXECUTION_CRITICAL & RESOLUTION_REQUIRES_MODEL_GUESS -> HALT;
	RETURN "RESOLVED_VALUE";
STATE:{IN=SOURCE_VALUE|LEXICAL_TYPE|SEMANTIC_TYPE|EXECUTION_CRITICAL;OUT=RESOLVED_VALUE|RESOLUTION_AUTHORITY|DIAGNOSTICS;PRECEDENCE=SEMANTIC_CONTRACT>LEXICAL_DEFAULT>INTERPRETIVE_CONTEXT>MODEL_INFERENCE}
}
