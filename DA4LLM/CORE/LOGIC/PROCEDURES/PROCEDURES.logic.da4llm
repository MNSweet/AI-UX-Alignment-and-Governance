#@da4llm:0.1.0-candidate;@layer:core;@kind:logic;@module:procedures;
EXECUTE_REQUEST{
PRECONDITION: REQUEST_PRESENT
ACTION:
	CALL_PROCEDURE "VALIDATE_CORE";
	IF CORE_INVALID -> HALT;
	IF GOVERNANCE_PRESENT -> CALL_PROCEDURE "DISPATCH_HOOK_PRE_EXECUTION";
	IF HOOK_STATUS_DENIED|HOOK_STATUS_LOCKED -> DENY "EXECUTION_DENIED_BY_GOVERNANCE";
	IF HOOK_STATUS_DENIED|HOOK_STATUS_LOCKED -> HALT;
	IF HOOK_STATUS_APPROVAL_REQUIRED -> ERROR "EXECUTION_APPROVAL_REQUIRED";
	IF HOOK_STATUS_APPROVAL_REQUIRED -> HALT;
	CALL_PROCEDURE "RESOLVE_REQUEST_PROCEDURE";
	IF REQUEST_PROCEDURE_UNRESOLVED -> ERROR "PROCEDURE_UNRESOLVED";
	IF REQUEST_PROCEDURE_UNRESOLVED -> HALT;
	CALL_PROCEDURE "EXECUTE_RULES_TOP_TO_BOTTOM";
	IF OUTPUT_PENDING & GOVERNANCE_PRESENT -> CALL_PROCEDURE "DISPATCH_HOOK_PRE_OUTPUT";
	IF OUTPUT_PENDING -> EMIT_RESPONSE "OUTPUT";
	IF OUTPUT_EMITTED & GOVERNANCE_PRESENT -> CALL_PROCEDURE "DISPATCH_HOOK_POST_OUTPUT";
	IF OUTPUT_EMITTED -> RETURN "OUTPUT";
	CONTINUE;
STATE:{IN=REQUEST|ACTIVE_CONTEXT|EXECUTION_MODE;OUT=OUTPUT|TRACE|DIAGNOSTICS;ORDER=VALIDATE>PRE_EXECUTION>RESOLVE>EXECUTE>PRE_OUTPUT>EMIT_OUTPUT>POST_OUTPUT>RETURN}
}

RESOLVE_REQUEST_PROCEDURE{
PRECONDITION: REQUEST_PRESENT & CORE_READY
ACTION:
	IF EXPLICIT_PROCEDURE_PRESENT -> SET "REQUEST_PROCEDURE=EXPLICIT_PROCEDURE";
	IF !EXPLICIT_PROCEDURE_PRESENT & ONE_COMPATIBLE_PROCEDURE -> SET "REQUEST_PROCEDURE=COMPATIBLE_PROCEDURE";
	IF !EXPLICIT_PROCEDURE_PRESENT & MULTIPLE_COMPATIBLE_PROCEDURES -> ERROR "PROCEDURE_AMBIGUOUS";
	IF !EXPLICIT_PROCEDURE_PRESENT & MULTIPLE_COMPATIBLE_PROCEDURES -> HALT;
	IF NO_COMPATIBLE_PROCEDURE -> SET "REQUEST_PROCEDURE_UNRESOLVED=TRUE";
	IF REQUEST_PROCEDURE_PRESENT -> RETURN "REQUEST_PROCEDURE";
STATE:{IN=REQUEST|AVAILABLE_PROCEDURES|ACTIVE_CONTEXT;OUT=REQUEST_PROCEDURE|REQUEST_PROCEDURE_UNRESOLVED|DIAGNOSTICS;PRECEDENCE=EXPLICIT>ONE_COMPATIBLE>UNRESOLVED}
}

EXECUTE_RULES_TOP_TO_BOTTOM{
PRECONDITION: PROCEDURE_VALID
ACTION:
	SET "RULE_CURSOR=FIRST_RULE";
	CALL_PROCEDURE "EXECUTE_RULE_AT_CURSOR";
	RETURN "PROCEDURE_STATE";
STATE:{IN=PROCEDURE|STATE;OUT=PROCEDURE_STATE|TRACE|DIAGNOSTICS;MULTIPLE_TRUE=EXECUTE_ALL;IMPLICIT_ELSE=FALSE}
}

EXECUTE_RULE_AT_CURSOR{
PRECONDITION: RULE_CURSOR_PRESENT
ACTION:
	IF CURRENT_CONDITION_TRUE -> CALL_PROCEDURE "DISPATCH_OPCODE";
	IF CURRENT_CONDITION_FALSE -> CONTINUE;
	IF CURRENT_CONDITION_UNRESOLVED -> ERROR "CONDITION_UNRESOLVED";
	IF CURRENT_CONDITION_UNRESOLVED -> HALT;
	IF CURRENT_RULE_COMPLETE & NEXT_RULE_PRESENT -> SET "RULE_CURSOR=NEXT_RULE";
	IF CURRENT_RULE_COMPLETE & NEXT_RULE_PRESENT -> RETRY;
	IF NO_NEXT_RULE -> RETURN "PROCEDURE_STATE";
STATE:{IN=PROCEDURE|STATE|RULE_CURSOR;OUT=PROCEDURE_STATE|RULE_CURSOR|TRACE|DIAGNOSTICS;RETRY_BOUND=RULE_COUNT}
}

DISPATCH_OPCODE{
PRECONDITION: OPCODE_PRESENT
ACTION:
	IF OPCODE_UNKNOWN -> ERROR "OPCODE_UNKNOWN";
	IF OPCODE_UNKNOWN -> HALT;
	IF OPCODE_CALL_PROCEDURE -> CALL_PROCEDURE "TARGET_PROCEDURE";
	IF OPCODE_CALL_CAPABILITY -> CALL_PROCEDURE "CALL_CAPABILITY_GENERIC";
	IF OPCODE_CORE_PRIMITIVE -> CALL_PROCEDURE "TARGET_PRIMITIVE";
	IF OPCODE_STATE|OPCODE_FLOW|OPCODE_OUTPUT|OPCODE_DIAGNOSTIC -> APPLY_OPCODE "CURRENT_OPCODE";
	CONTINUE;
STATE:{IN=OPCODE|ARGUMENTS|STATE;OUT=STATE|TRACE|DIAGNOSTICS;AUTHORITY=OPCODES_SEMANTIC}
}

INTERSECTS{
PRECONDITION: START
ACTION:
	SET "RESULT=FALSE";
	IF !A|!B -> CONTINUE;
	IF OVERLAP_EXISTS_PRIMITIVE -> SET "RESULT=TRUE";
	RETURN "RESULT";
STATE:{IN=A|B;OUT=RESULT;TAG=GENERAL}
}

CLAMP{
PRECONDITION: START
ACTION:
	SET "RESULT=VALUE";
	IF VALUE<MIN -> SET "RESULT=MIN";
	IF VALUE>MAX -> SET "RESULT=MAX";
	RETURN "RESULT";
STATE:{IN=VALUE|MIN|MAX;OUT=RESULT;TAG=GENERAL}
}

COALESCE{
PRECONDITION: START
ACTION:
	SET "RESULT=DEFAULT";
	IF VALUE_PRESENT -> SET "RESULT=VALUE";
	RETURN "RESULT";
STATE:{IN=VALUE|VALUE_PRESENT|DEFAULT;OUT=RESULT;TAG=GENERAL}
}
