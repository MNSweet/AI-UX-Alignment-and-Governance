#@da4llm:0.1.0-candidate;@layer:core;@kind:logic;@module:parser;
PARSER_DEFINE_PRODUCTIONS{
PRECONDITION: TOKEN_DEFINITIONS_PRESENT
ACTION:
	SET "FILE=DIRECTIVE NEWLINE BLOCK+";
	SET "BLOCK=LOGIC_BLOCK|SEMANTIC_BLOCK";
	SET "LOGIC_BLOCK=NAME LBRACE NEWLINE PRECONDITION_SECTION ACTION_SECTION STATE_SECTION RBRACE NEWLINE";
	SET "PRECONDITION_SECTION=PRECONDITION COLON CONDITION NEWLINE";
	SET "ACTION_SECTION=ACTION COLON NEWLINE ACTION_RULE+";
	SET "ACTION_RULE=(IF CONDITION ARROW OPCODE ARGUMENT_OPTIONAL|OPCODE ARGUMENT_OPTIONAL) SEMICOLON NEWLINE";
	SET "STATE_SECTION=STATE COLON LBRACE STATE_ENTRY_LIST RBRACE NEWLINE";
	SET "SEMANTIC_BLOCK=NAME LBRACE NEWLINE SEMANTIC_FIELD+ RBRACE NEWLINE";
	SET "SEMANTIC_FIELD=NAME COLON STRING SEMICOLON NEWLINE";
	RETURN "PARSER_PRODUCTIONS";
STATE:{IN=TOKEN_DEFINITIONS;OUT=PARSER_PRODUCTIONS;TAG=PARSER_SPEC}
}

PARSE_FILE{
PRECONDITION: TOKEN_STREAM_PRESENT
ACTION:
	CALL_PROCEDURE "PARSER_DEFINE_PRODUCTIONS";
	REQUIRE "DIRECTIVE_FIRST";
	REQUIRE "ONE_OR_MORE_BLOCKS";
	IF DIRECTIVE_INVALID -> ERROR "DIRECTIVE_INVALID";
	IF DIRECTIVE_INVALID -> HALT;
	SET "PARSER_CURSOR=FIRST_TOKEN";
	CALL_PROCEDURE "PARSE_NEXT_TOKEN";
	IF PARSE_ERROR -> HALT;
	RETURN "PARSE_TREE";
STATE:{IN=TOKEN_STREAM;OUT=PARSE_TREE|PARSER_DIAGNOSTICS;ORDER=TOP_TO_BOTTOM;EXTRA_CONTENT=FORBIDDEN}
}

PARSE_NEXT_TOKEN{
PRECONDITION: PARSER_CURSOR_PRESENT & !SOURCE_END
ACTION:
	IF CURRENT_TOKEN_PRESENT -> PUSH_STATE "PARSE_TREE_TOKEN";
	IF BLOCK_OPEN -> PUSH_STATE "BLOCK";
	IF BLOCK_CLOSE -> POP_STATE "BLOCK";
	IF BLOCK_CLOSE_WITHOUT_OPEN -> ERROR "BLOCK_UNBALANCED";
	IF LOGIC_BLOCK_COMPLETE -> CALL_PROCEDURE "PARSE_LOGIC_BLOCK";
	IF SEMANTIC_BLOCK_COMPLETE -> CALL_PROCEDURE "PARSE_SEMANTIC_BLOCK";
	IF PARSE_ERROR -> HALT;
	IF CURRENT_TOKEN_COMPLETE -> SET "PARSER_CURSOR=NEXT_TOKEN";
	IF SOURCE_END & BLOCK_OPEN -> ERROR "BLOCK_UNBALANCED";
	IF SOURCE_END & BLOCK_OPEN -> HALT;
	IF !SOURCE_END -> RETRY;
	IF SOURCE_END & !PARSE_ERROR -> RETURN "PARSE_TREE";
STATE:{IN=TOKEN_STREAM|PARSER_CURSOR|PARSER_PRODUCTIONS;OUT=PARSE_TREE|PARSER_CURSOR|PARSER_DIAGNOSTICS;RETRY_BOUND=TOKEN_COUNT}
}

PARSE_LOGIC_BLOCK{
PRECONDITION: DIRECTIVE_KIND_LOGIC
ACTION:
	REQUIRE "NAME";
	REQUIRE "PRECONDITION_SECTION";
	REQUIRE "ACTION_SECTION";
	REQUIRE "STATE_SECTION";
	IF SECTION_DUPLICATE -> ERROR "SECTION_DUPLICATE";
	IF SECTION_ORDER_INVALID -> ERROR "SECTION_ORDER_INVALID";
	IF ACTION_RULE_INVALID -> ERROR "ACTION_RULE_INVALID";
	IF LOGIC_BLOCK_VALID -> RETURN "LOGIC_BLOCK";
STATE:{IN=BLOCK_TOKENS;OUT=LOGIC_BLOCK;SECTION_ORDER=PRECONDITION>ACTION>STATE}
}

PARSE_SEMANTIC_BLOCK{
PRECONDITION: DIRECTIVE_KIND_SEMANTIC
ACTION:
	REQUIRE "SEMANTIC_NAME";
	REQUIRE "TYPE_FIELD";
	REQUIRE "PURPOSE_FIELD";
	IF CONTROL_FLOW_OPCODE_PRESENT -> ERROR "SEMANTIC_CONTAINS_LOGIC";
	IF SEMANTIC_FIELD_DUPLICATE -> ERROR "SEMANTIC_FIELD_DUPLICATE";
	IF SEMANTIC_BLOCK_VALID -> RETURN "SEMANTIC_BLOCK";
STATE:{IN=BLOCK_TOKENS;OUT=SEMANTIC_BLOCK;OPTIONAL_FIELDS=PATTERN|INPUTS|OUTPUTS|DEFAULT|RESTRICTIONS|FAILURE|MEANING}
}

PARSE_ACTION_RULE{
PRECONDITION: ACTION_RULE_PRESENT
ACTION:
	IF RULE_STARTS_IF -> REQUIRE "CONDITION_ARROW_OPCODE";
	IF RULE_STARTS_OPCODE -> REQUIRE "OPCODE_ARGUMENT_OPTIONAL";
	IF RULE_MISSING_SEMICOLON -> ERROR "RULE_TERMINATOR_MISSING";
	IF MULTIPLE_OPCODES_ON_LINE -> ERROR "ONE_RULE_PER_LINE_REQUIRED";
	IF ACTION_RULE_VALID -> RETURN "ACTION_RULE";
STATE:{IN=RULE_TOKENS;OUT=ACTION_RULE;FORM=IF_CONDITION_ARROW_OPCODE|OPCODE}
}
