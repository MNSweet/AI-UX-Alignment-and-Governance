#@da4llm:0.1.0-candidate;@layer:tests;@kind:logic;@module:core_poc;
TEST_CORE_STANDALONE{
PRECONDITION: CORE_MODULES_PRESENT & !BRIDGE_PRESENT & !GOVERNANCE_PRESENT
ACTION:
	SET "EXECUTION_MODE=NORMAL";
	CALL_PROCEDURE "CORE_BOOTSTRAP";
	ASSERT "CORE_VALID=TRUE";
	ASSERT "CORE_READY=TRUE";
	CONTINUE;
STATE:{IN=CORE_CONTEXT;OUT=TEST_RESULT;EXPECT=PASS;PROVES=CORE_INDEPENDENCE}
}

TEST_SEMANTIC_TYPE_PRECEDENCE{
PRECONDITION: CORE_READY
ACTION:
	SET "SOURCE_VALUE=4";
	SET "LEXICAL_TYPE=INTEGER";
	SET "SEMANTIC_TYPE=STRING";
	SET "EXECUTION_CRITICAL=TRUE";
	CALL_PROCEDURE "RESOLVE_SEMANTIC_VALUE";
	ASSERT "RESOLVED_VALUE=STRING_4";
	ASSERT "RESOLUTION_AUTHORITY=SEMANTIC_CONTRACT";
	CONTINUE;
STATE:{IN=SOURCE_VALUE|LEXICAL_TYPE|SEMANTIC_TYPE;OUT=RESOLVED_VALUE|RESOLUTION_AUTHORITY;EXPECT=PASS}
}

TEST_NORMAL_MISSING_SEMANTIC{
PRECONDITION: CORE_READY
ACTION:
	SET "EXECUTION_MODE=NORMAL";
	SET "SEMANTIC_STATE=SEMANTIC_ABSENT";
	CALL_PROCEDURE "VALIDATE_MODULE_PAIRS";
	ASSERT "EXECUTION_CONTINUES=TRUE";
	ASSERT "SEMANTIC_WARNING_VISIBLE=FALSE";
	CONTINUE;
STATE:{IN=LOGIC_MODULE|EXECUTION_MODE;OUT=SEMANTIC_STATE|DIAGNOSTICS;EXPECT=PASS}
}

TEST_DEBUG_MISSING_SEMANTIC{
PRECONDITION: CORE_READY
ACTION:
	SET "EXECUTION_MODE=DEBUG";
	SET "SEMANTIC_STATE=SEMANTIC_ABSENT";
	CALL_PROCEDURE "VALIDATE_MODULE_PAIRS";
	ASSERT "EXECUTION_CONTINUES=TRUE";
	ASSERT "SEMANTIC_WARNING_VISIBLE=TRUE";
	CONTINUE;
STATE:{IN=LOGIC_MODULE|EXECUTION_MODE;OUT=SEMANTIC_STATE|DIAGNOSTICS;EXPECT=PASS}
}

TEST_STRICT_MISSING_SEMANTIC{
PRECONDITION: CORE_READY
ACTION:
	SET "EXECUTION_MODE=STRICT";
	SET "SEMANTIC_STATE=SEMANTIC_ABSENT";
	CALL_PROCEDURE "VALIDATE_MODULE_PAIRS";
STATE:{IN=LOGIC_MODULE|EXECUTION_MODE;OUT=SEMANTIC_STATE|DIAGNOSTICS;EXPECT=HALT_EXPECTED;EXPECT_DIAGNOSTIC=SEMANTIC_REQUIRED}
}

TEST_MISSING_BRIDGE_CONTINUE{
PRECONDITION: CORE_READY & !BRIDGE_PRESENT
ACTION:
	SET "CAPABILITY_NAME=DEMONSTRATION_CAPABILITY";
	SET "CALLER_ON_UNAVAILABLE=CONTINUE";
	CALL_PROCEDURE "CALL_CAPABILITY_GENERIC";
	ASSERT "CAPABILITY_STATUS=CAPABILITY_UNAVAILABLE";
	ASSERT "EXECUTION_CONTINUES=TRUE";
	CONTINUE;
STATE:{IN=CAPABILITY_NAME|CALLER_ON_UNAVAILABLE;OUT=CAPABILITY_STATUS|DIAGNOSTICS;EXPECT=PASS}
}

TEST_MISSING_BRIDGE_HALT{
PRECONDITION: CORE_READY & !BRIDGE_PRESENT
ACTION:
	SET "CAPABILITY_NAME=DEMONSTRATION_CAPABILITY";
	SET "CALLER_ON_UNAVAILABLE=HALT";
	CALL_PROCEDURE "CALL_CAPABILITY_GENERIC";
STATE:{IN=CAPABILITY_NAME|CALLER_ON_UNAVAILABLE;OUT=CAPABILITY_STATUS|DIAGNOSTICS;EXPECT=HALT_EXPECTED;EXPECT_DIAGNOSTIC=CAPABILITY_UNAVAILABLE}
}

TEST_GOVERNANCE_ABSENT_NO_OP{
PRECONDITION: CORE_READY & !GOVERNANCE_PRESENT
ACTION:
	SET "HOOK_NAME=PRE_EXECUTION";
	CALL_PROCEDURE "DISPATCH_HOOK";
	ASSERT "HOOK_STATUS=NO_OP";
	ASSERT "EXECUTION_CONTINUES=TRUE";
	CONTINUE;
STATE:{IN=HOOK_NAME;OUT=HOOK_STATUS;EXPECT=PASS}
}

TEST_SEMANTIC_CONTROL_FLOW_REJECTED{
PRECONDITION: SEMANTIC_ENTRY_PRESENT
ACTION:
	SET "SEMANTIC_ENTRY_WITH_CONTROL_FLOW=TRUE";
	CALL_PROCEDURE "VALIDATE_SEMANTIC_COVERAGE";
STATE:{IN=SEMANTIC_MODULE;OUT=DIAGNOSTICS;EXPECT=HALT_EXPECTED;EXPECT_DIAGNOSTIC=SEMANTIC_CONTAINS_LOGIC}
}
