#@da4llm:0.1.0-candidate;@layer:bridge;@kind:logic;@module:bridge_placeholder;@status:placeholder;
BRIDGE_PLACEHOLDER{
PRECONDITION: BRIDGE_REQUESTED
ACTION:
	SET "BRIDGE_STATUS=NOT_IMPLEMENTED";
	SET "BRIDGE_PRESENT=FALSE";
	SET "CAPABILITY_MAPPINGS=EMPTY";
	RETURN "BRIDGE_STATUS";
STATE:{IN=CAPABILITY_NAME|MODEL_ECOSYSTEM;OUT=BRIDGE_STATUS;PROVIDERS=NONE;STATUS=PLACEHOLDER}
}
